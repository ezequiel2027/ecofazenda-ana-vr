# NÃO coloque a chave real no GitHub.
# No Render, cadastre estas variáveis em Environment.
GEMINI_API_KEY=COLE_SUA_CHAVE_NO_RENDER
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: só defina se quiser substituir os modelos padrão do código.
# GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Localmente pode usar PORT=3000. No Render, PORT é fornecida automaticamente.
PORT=3000
